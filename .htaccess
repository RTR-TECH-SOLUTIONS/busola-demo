# Hostinger / Apache. Echivalentul lui deploy/nginx.conf, pentru găzduire partajată.
# Fără asta, aplicația merge doar de pe pagina principală: orice reîncărcare pe o
# rută internă (/app/masa-sistemica) cere serverului un fișier care nu există și
# întoarce 404. E o aplicație pe o singură pagină — rutele le rezolvă browserul.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # fișierele reale (js, css, imagini) se servesc ca atare
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # restul merg la index.html, care pornește aplicația pe ruta cerută
  RewriteRule . /index.html [L]
</IfModule>

# Fișierele din /assets/ au hash în nume: se pot ține în cache la nesfârșit.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html NU se ține în cache, altfel clienta rămâne pe o versiune veche
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Link temporar de prezentare — să nu ajungă în Google.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
